-- ServerScriptService/LevelService (ModuleScript)
local LevelService = {}

local MAX_LEVEL = 100
local XP_PER_LEVEL = 100 -- XP cần = level hiện tại * XP_PER_LEVEL

local function xpNeeded(level)
	return level * XP_PER_LEVEL
end

function LevelService.setup(player)
	if player:FindFirstChild("leaderstats") then return end

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"

	local level = Instance.new("IntValue")
	level.Name = "Level"
	level.Value = 1
	level.Parent = stats

	local xp = Instance.new("IntValue")
	xp.Name = "XP"
	xp.Value = 0
	xp.Parent = stats

	stats.Parent = player
end

function LevelService.addXP(player, amount)
	if typeof(amount) ~= "number" or amount <= 0 then return end

	local stats = player:FindFirstChild("leaderstats")
	local level = stats and stats:FindFirstChild("Level")
	local xp = stats and stats:FindFirstChild("XP")
	if not (level and xp) then return end

	if level.Value >= MAX_LEVEL then
		xp.Value = 0
		return
	end

	xp.Value += math.floor(amount)
	while level.Value < MAX_LEVEL and xp.Value >= xpNeeded(level.Value) do
		xp.Value -= xpNeeded(level.Value)
		level.Value += 1
	end
	if level.Value >= MAX_LEVEL then
		xp.Value = 0
	end
end

return LevelService
