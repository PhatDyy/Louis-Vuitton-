-- Script đơn giản để tự động nhặt trái cây trong Blox Fruits

local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local backpack = player.Backpack

-- Hàm kiểm tra xem có trái cây nào gần đó không
local function findFruit()
    for _, instance in ipairs(workspace:GetChildren()) do
        if instance:IsA("Model") and instance.Name == "Fruit" then
            -- Kiểm tra xem trái cây có thuộc về người chơi khác không (tùy chọn)
            if not instance.Parent:FindFirstChild("Humanoid") then
                return instance
            end
        end
    end
    return nil
end

-- Hàm di chuyển đến vị trí của trái cây và nhặt nó
local function pickUpFruit()
    local fruit = findFruit()
    if fruit then
        print("Tìm thấy trái cây: " .. fruit.Name)
        -- Di chuyển nhân vật đến vị trí của trái cây
        -- (Cần thêm logic di chuyển phức tạp hơn ở đây nếu cần)
        -- Ví dụ đơn giản: Teleport đến gần trái cây
        character.HumanoidRootPart.CFrame = CFrame.new(fruit.PrimaryPart.Position - Vector3.new(0, 5, 0))

        -- Chờ một chút để nhân vật đến nơi
        wait(1)

        -- Tương tác để nhặt trái cây
        -- (Cần tìm cách tương tác với trái cây, có thể là click vào nó hoặc sử dụng một sự kiện)
        -- Ví dụ giả định:
        -- game:GetService("ReplicatedStorage").Events.PickUpFruit:FireServer(fruit)
        print("Đang cố gắng nhặt trái cây...")
    else
        print("Không tìm thấy trái cây nào gần đây.")
    end
end

-- Vòng lặp chính để liên tục tìm và nhặt trái cây
while wait(5) do -- Kiểm tra mỗi 5 giây
    pickUpFruit()
end
