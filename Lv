-- Hàm để tải cấu hình từ xa (ví dụ: từ Pastebin hoặc GitHub Gist)
local function loadRemoteConfig()
    local pastebinUrl = "YOUR_PASTEBIN_URL_HERE" -- Thay thế bằng URL Pastebin của bạn
    local success, data = pcall(function()
        return HttpService:GetAsync(pastebinUrl)
    end)

    if success then
        local decodedData = HttpService:JSONDecode(data)
        if decodedData then
            -- Cập nhật các giá trị trong config từ dữ liệu tải về
            for key, value in pairs(decodedData) do
                if config[key] ~= nil then
                    config[key] = value
                end
            end
            print("Đã tải cấu hình từ xa thành công!")
        else
            warn("Không thể giải mã dữ liệu cấu hình từ xa.")
        end
    else
        warn("Không thể tải cấu hình từ xa: " .. data)
    end
end

