-- Tự động trang bị vũ khí ngầm
local function EquipWeapon()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local currentTool = char:FindFirstChildOfClass("Tool")
        if currentTool and currentTool.ToolTip == _G.SelectWeapon then return end
        
        for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") and tool.ToolTip == _G.SelectWeapon then
                humanoid:EquipTool(tool)
            end
        end
    end)
end

-- TRUE ATTACK AURA: Tự động kích hoạt Tool ngầm, ép quái tự chết hàng loạt trong phạm vi mà không cần click chuột
task.spawn(function()
    while task.wait(0.01) do
        if _G.AutoFarm then
            pcall(function()
                EquipWeapon()
                local char = LocalPlayer.Character
                local tool = char and char:FindFirstChildOfClass("Tool")
                if tool then
                    -- Kích hoạt Tool liên tục (gây sát thương diện rộng tự động)
                    tool:Activate()
                end
            end)
        end
    end
end)

