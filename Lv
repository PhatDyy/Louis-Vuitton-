-- Function to load remote configuration (e.g., from Pastebin or GitHub Gist)
local function loadRemoteConfig()
    local pastebinUrl = "YOUR_PASTEBIN_URL_HERE" -- Replace with your Pastebin URL
    local success, data = pcall(function()
        return HttpService:GetAsync(pastebinUrl)
    end)

    if success then
        local decodedData = HttpService:JSONDecode(data)
        if decodedData then
            -- Update config values from the downloaded data
            for key, value in pairs(decodedData) do
                if config[key] ~= nil then
                    config[key] = value
                end
            end
            print("Successfully loaded remote configuration!")
        else
            warn("Failed to decode remote configuration data.")
        end
    else
        warn("Failed to load remote configuration: " .. data)
    end
end

