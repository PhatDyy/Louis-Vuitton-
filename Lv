local function HasActiveQuest()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        local main = playerGui:FindFirstChild("Main")
        if main then
            local quest = main:FindFirstChild("Quest")
            if quest and quest.Visible then
                return true
            end
        end
    end
    return false
end

local function GetQuestGiverCFrame()
    return CFrame.new(0, 10, 0) 
end

local activeTween = nil
local function StopTween()
    if activeTween then
        activeTween:Cancel()
        activeTween = nil
    end
end

local function LinearTweenTo(targetCFrame)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    StopTween()
    
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local speed = 170
    local duration = distance / speed
    
    if duration <= 0 then return end
    
    local info = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    activeTween = TweenService:Create(hrp, info, {CFrame = targetCFrame})
    activeTween:Play()
    
    local elapsed = 0
    while elapsed < duration and activeTween and activeTween.PlaybackState == Enum.PlaybackState.Playing do
        if not _G.AutoFarmLevel then
            StopTween()
            break
        end
        elapsed += RunService.Heartbeat:Wait()
    end
end

