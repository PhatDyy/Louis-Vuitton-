-- Backend: Tự động cầm vũ khí
local function EquipWeapon()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") and tool.ToolTip == _G.SelectWeapon then
                char.Humanoid:EquipTool(tool)
            end
        end
    end)
end

-- Backend: Attack Aura (Tự động kích hoạt đánh diện rộng liên tục)
task.spawn(function()
    while task.wait(0.01) do
        if _G.AttackAuraFarm then
            pcall(function()
                EquipWeapon()
                local char = LocalPlayer.Character
                if char and char:FindFirstChildOfClass("Tool") then
                    char:FindFirstChildOfClass("Tool"):Activate()
                end
                
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local myPos = char.HumanoidRootPart.Position
                    if workspace:FindFirstChild("Enemies") then
                        for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                            if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                                if (enemy.HumanoidRootPart.Position - myPos).Magnitude <= 55 then
                                    game:GetService("VirtualUser"):Button1Down(Vector2.new(0,0))
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- Backend: Giữ độ cao cố định, không bay lên xuống ngắt quãng
local TweenService = game:GetService("TweenService")
local currentTween = nil

local function TweenToFixedAltitude(targetPos)
    pcall(function()
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character:FindFirstChild("Humanoid") then
            local hrp = LocalPlayer.Character.HumanoidRootPart
            local humanoid = LocalPlayer.Character.Humanoid
            humanoid.PlatformStand = true
            
            local distance = (hrp.Position - targetPos).Magnitude
            local tweenTime = distance / _G.TweenSpeed
            local tweenInfo = TweenInfo.new(tweenTime, Enum.EasingStyle.Linear)
            
            if currentTween then currentTween:Cancel() end
            currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
            currentTween:Play()
            
            currentTween.Completed:Connect(function()
                humanoid.PlatformStand = false
            end)
        end
    end)
end

-- Vòng lặp tìm quái gần nhất và neo giữ ở một độ cao cố định trên đầu quái
task.spawn(function()
    while task.wait(0.1) do
        if _G.AttackAuraFarm and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            pcall(function()
                local hrp = LocalPlayer.Character.HumanoidRootPart
                local targetMob = nil
                local shortestDistance = math.huge

                if workspace:FindFirstChild("Enemies") then
                    for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                        if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                            local dist = (enemy.HumanoidRootPart.Position - hrp.Position).Magnitude
                            if dist < shortestDistance then
                                shortestDistance = dist
                                targetMob = enemy
                            end
                        end
                    end
                end

                if targetMob and targetMob:FindFirstChild("HumanoidRootPart") then
                    -- Tính toán vị trí đứng cố định trên đầu quái với chiều cao _G.FarmHeight
                    local mobPos = targetMob.HumanoidRootPart.Position
                    local fixedPosition = Vector3.new(mobPos.X, mobPos.Y + _G.FarmHeight, mobPos.Z)
                    
                    -- Chỉ thực hiện di chuyển mượt mà nếu khoảng cách lệch đáng kể để tránh rung lắc
                    if (hrp.Position - fixedPosition).Magnitude > 3 then
                        TweenToFixedAltitude(fixedPosition)
                    end
                end
            end)
        end
    end
end)

