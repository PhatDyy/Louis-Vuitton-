-- Lấy Level hiện tại của người chơi
local function GetPlayerLevel()
    local lvl = 1
    pcall(function()
        if LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Level") then
            lvl = LocalPlayer.Data.Level.Value
        elseif LocalPlayer:FindFirstChild("leaderstats") and LocalPlayer.leaderstats:FindFirstChild("Level") then
            lvl = LocalPlayer.leaderstats.Level.Value
        end
    end)
    return lvl
end

-- Tự động cầm vũ khí
local function EquipWeapon()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") and tool.ToolTip == _G.SelectWeapon then
                char.Humanoid:EquipTool(tool)
            end
        end
    end)
end

-- Attack Aura & Fast Attack (Đánh diện rộng tự động như video)
task.spawn(function()
    while task.wait(0.01) do
        if _G.AutoFarm then
            pcall(function()
                EquipWeapon()
                local char = LocalPlayer.Character
                if char and char:FindFirstChildOfClass("Tool") then
                    char:FindFirstChildOfClass("Tool"):Activate()
