local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

-- Configuration
local settings = {
    melee = true,          -- Use melee (Z)
    sword = true,          -- Use sword (X)
    abilities = true,      -- Use abilities (C, V, F, G)
    collectDrops = true,   -- Collect dropped items
    teleportToEnemy = true, -- Teleport to enemy for faster farming
    attackRange = 20,      -- Distance to start attacking
    teleportRange = 50     -- Distance to teleport to enemy
}

-- Find the nearest enemy
function getNearestEnemy()
    local nearest = nil
    local minDist = math.huge
    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return nil, minDist end

    for _, enemy in ipairs(enemiesFolder:GetChildren()) do
        local enemyHumanoid = enemy:FindFirstChild("Humanoid")
        local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")
        if enemyHumanoid and enemyRoot and enemyHumanoid.Health > 0 then
            local dist = (rootPart.Position - enemyRoot.Position).Magnitude
            if dist < minDist then
                minDist = dist
                nearest = enemy
            end
        end
    end
    return nearest, minDist
end

-- Send a key press event
function pressKey(key)
    local vim = game:GetService("VirtualInputManager")
    vim:SendKeyEvent(true, key, false, game)
    wait(0.1)
    vim:SendKeyEvent(false, key, false, game)
end

-- Attack the target enemy
function attack(target)
    local enemyRoot = target:FindFirstChild("HumanoidRootPart")
    if not enemyRoot then return end

    -- Face the enemy
    rootPart.CFrame = CFrame.lookAt(rootPart.Position, enemyRoot.Position)

    -- Use melee and sword
    if settings.melee then pressKey("Z") end
    if settings.sword then pressKey("X") end

    -- Use abilities
    if settings.abilities then
        for _, key in ipairs({"C", "V", "F", "G"}) do
            pressKey(key)
        end
    end
end

