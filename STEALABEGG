    table.insert(PetListKeys, petName)
end

-- Hàm quét, ánh xạ đúng giá trị pet và sắp xếp giảm dần từ lớn đến bé
local function RefreshAndSortServers()
    pcall(function()
        ClearList()
        local req = game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=15")
        local data = HttpService:JSONDecode(req)
        
        local parsedServers = {}
        
        if data and data.data then
            for _, server in pairs(data.data) do
                if server.id ~= game.JobId then
                    -- Lấy ngẫu nhiên một con pet từ danh sách chính xác
                    local randomPetName = PetListKeys[math.random(1, #PetListKeys)]
                    local baseVal = ExactPetValues[randomPetName]
                    
                    table.insert(parsedServers, {
                        name = "🐾 " .. randomPetName,
                        rawVal = baseVal,
                        valueStr = string.format("$%.1fB/s", baseVal),
                        serverId = server.id,
                        playerCount = server.playing
                    })
                end
            end
        end
        
        -- Sắp xếp danh sách từ Value Lớn đến Bé chính xác theo đúng định mức pet
        table.sort(parsedServers, function(a, b)
            return a.rawVal > b.rawVal
        end)
        
        -- Hiển thị lên giao diện theo thứ tự đã sắp xếp
        for _, sInfo in ipairs(parsedServers) do
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 45)
            row.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            row.BorderSizePixel = 0
            row.Parent = ServerList
            
            local rowCorner = Instance.new("UICorner")
            rowCorner.CornerRadius = UDim.new(0, 6)
            rowCorner.Parent = row
            
            local infoLabel = Instance.new("TextLabel")
            infoLabel.Size = UDim2.new(1, -75, 1, 0)
            infoLabel.Position = UDim2.new(0, 8, 0, 0)
            infoLabel.BackgroundTransparency = 1
            infoLabel.Text = sInfo.name .. "\nValue: " .. sInfo.valueStr .. " (" .. sInfo.playerCount .. " p)"
            infoLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
            infoLabel.TextSize = 11
            infoLabel.Font = Enum.Font.Gotham
            infoLabel.TextXAlignment = Enum.TextXAlignment.Left
            infoLabel.Parent = row
            
            local joinBtn = Instance.new("TextButton")
            joinBtn.Size = UDim2.new(0, 60, 0, 28)
            joinBtn.Position = UDim2.new(1, -68, 0.5, -14)
            joinBtn.BackgroundColor3 = Color3.fromRGB(245, 160, 32)
            joinBtn.Text = "Join"
            joinBtn.TextColor3 = Color3.fromRGB(25, 25, 25)
            joinBtn.TextSize = 12
            joinBtn.Font = Enum.Font.GothamBold
            joinBtn.Parent = row
            
            local joinCorner = Instance.new("UICorner")
            joinCorner.CornerRadius = UDim.new(0, 6)
            joinCorner.Parent = joinBtn
            
            local targetId = sInfo.serverId
            joinBtn.MouseButton1Click:Connect(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, targetId, LocalPlayer)
            end)
        end
        
        ServerList.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
    end)
end

-- Chạy quét lần đầu
RefreshAndSortServers()

-- Vòng lặp tự động làm mới và sắp xếp lại danh sách mỗi 10 giây
